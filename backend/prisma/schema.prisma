// Prisma schema for Component Usage Checker
// Defines three tables: User, Scan, Component
// Run "npx prisma migrate dev --name init" to apply this to your database

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  scans     Scan[]
  createdAt DateTime @default(now())
}

model Scan {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  projectName  String
  status       String      @default("pending")
  createdAt    DateTime    @default(now())
  components   Component[]
}

model Component {
  id          String   @id @default(uuid())
  scanId      String
  scan        Scan     @relation(fields: [scanId], references: [id])
  name        String
  definedIn   String
  usageCount  Int      @default(0)
  usedIn      Json
  reachable   Boolean  @default(true)
}
